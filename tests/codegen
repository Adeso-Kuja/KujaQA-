import { defineConfig, devices } from '@playwright/test';
import dotenv from 'dotenv';
import path from 'path';
import { callbackify } from 'util'

// Load environment variables from .env
dotenv.config();

// Define the path where the session will be stored
const authFile = path.join(process.cwd(), 'playwright/.auth/user.json');

export default defineConfig({
  testDir: './tests',
  fullyParallel: true,
  forbidOnly: !!process.env.CI,
  retries: process.env.CI ? 2 : 4,
  workers: process.env.CI ? 1 : undefined,
  reporter: 'html',

  /* GLOBAL TIMEOUT FOR ASSERTIONS */
  expect: {
    timeout: 20000, 
  },

  use: {
    /* Base URL to use in actions like `await page.goto('/')`. */
    baseURL: 'https://kuja.org/',

    /* Collect trace when retrying the failed test. */
    trace: 'on-first-retry',
    /* Take a screenshot only on failure to help with debugging */
    screenshot: 'only-on-failure',
    
    /* Optional: Record video only on the first retry */
    video: 'on-first-retry',

    /* Timeout for each action like click(), fill(), etc. */
    actionTimeout: 20000, 
  },

  projects: [
    // --- 1. SETUP PROJECT (Handles the Gmail OTP Login) ---
    {
      name: 'setup',
      testMatch: /auth\.setup\.js/, // Runs tests/auth.setup.js
      timeout: 90000,
    },

    // --- 2. MAIN TEST PROJECT (Reuses the Session) ---
    {
      name: 'chromium',
      use: { 
        ...devices['Desktop Chrome'],
        // Load the session saved by the setup project
        storageState: authFile,
      },
      // Ensures 'setup' runs before any chromium tests start
      dependencies: ['setup'],
    },
  ],
});








































